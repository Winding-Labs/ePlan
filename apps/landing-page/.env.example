# =============================================================================
# TurboPlan Landing Page Environment Variables
# =============================================================================
# Copy this file to `.env.local` in this directory:
#   cp .env.example .env.local
# This is a Next.js app, so `.env.local` is what it reads (and it takes
# precedence over `.env`).
#
# Env access goes through getLandingPageEnv() in @wildfires-org/turboplan-env,
# which is called at MODULE SCOPE in `src/app/layout.tsx`. A missing REQUIRED
# value below therefore throws during prerender for every route — it fails
# `next build`, not just one page.
#
# For the cross-cutting picture — which file each app reads, the four auth
# secrets, the minimum local setup, feature flags and deployment — see
# CONFIGURATION.md at the repo root.
# =============================================================================

# =============================================================================
# BRANDING
# =============================================================================

# Application display name used in metadata, navigation and the wordmark.
# OPTIONAL (strongly recommended).
# If unset: every one of those surfaces renders the literal placeholder
# "[Your Brand]" — nothing throws.
# Should match NEXT_PUBLIC_APP_NAME in apps/turboplan and APP_NAME in apps/server.
NEXT_PUBLIC_APP_NAME=

# Support address rendered on /contact as the mailto target.
# REQUIRED — /contact throws when this resolves to the placeholder
# "support@example.com", and because the page is statically prerendered that
# throw fails `next build`. This is a deliberate guard against shipping the
# placeholder inbox.
# Example: support@yourdomain.com
NEXT_PUBLIC_SUPPORT_EMAIL=

# =============================================================================
# APPLICATION URLS
# =============================================================================

# LinkedIn company URL. Validated by the env loader but not currently rendered
# by any page — it still has to be set.
# REQUIRED — there is no fallback.
# If unset: the root layout throws "Missing `NEXT_PUBLIC_LINKEDIN_URL` env
# variable" during prerender and the whole app fails to build.
# Example: https://linkedin.com/company/yourcompany
NEXT_PUBLIC_LINKEDIN_URL=

# URL of the TurboPlan web app — the target of every "sign in" / "open app" link.
# REQUIRED.
# If unset: the root layout throws "Missing `NEXT_PUBLIC_TURBOPLAN_URL` env
# variable" and the app fails to build.
# Local value: http://localhost:3000
NEXT_PUBLIC_TURBOPLAN_URL=http://localhost:3000

# URL of the Hono API server — the public catalog data comes from it.
# REQUIRED.
# If unset: the root layout throws "Missing `NEXT_PUBLIC_SERVER_URL` env
# variable" and the app fails to build.
# Local value: http://localhost:3001
NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# Public URL of this landing page — used as Next's `metadataBase` so og:image
# and canonical URLs are absolute.
# OPTIONAL.
# If unset: metadataBase is omitted and those URLs stay relative, which some
# social-preview crawlers reject. Nothing throws.
# Local value: http://localhost:3002
NEXT_PUBLIC_LANDING_URL=http://localhost:3002

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Stripe billing module — controls whether the pricing / checkout view is shown.
# Stripe keys live on the API server only; this page just needs the flag.
# OPTIONAL — only the literal "true" enables it; defaults to off when absent.
# If unset: the pricing and checkout routes render as disabled/hidden.
# Keep it in agreement with IS_BILLING_PACKAGE_ENABLED in apps/server, or the
# page offers a checkout the API refuses to start.
NEXT_PUBLIC_IS_BILLING_PACKAGE_ENABLED=false

# =============================================================================
# FILE STORAGE (Cloudflare R2)
# =============================================================================

# Public URL(s) of the R2 bucket(s) whose images this page renders (catalog
# cover images). Read at BUILD time and baked into next/image `remotePatterns` —
# changing it needs a rebuild.
# REQUIRED for catalog images to display.
# If unset: remotePatterns is empty and every remote image fails with "Invalid
# src prop ... hostname is not configured". Nothing throws; the pages render
# with broken images.
# Accepts a comma-separated list when images span several buckets.
# Example: https://pub-xxxx.r2.dev,https://pub-yyyy.r2.dev
R2_PUBLIC_URL=

# =============================================================================
# CROSS-DOMAIN AUTHENTICATION
# =============================================================================

# Secret used to verify session cookies minted by the web app, so the landing
# page can show a signed-in state.
# REQUIRED (server-side only; never reaches the browser bundle).
# If unset: the root layout throws "Missing `AUTH_SECRET` env variable (required
# for session verification)" and the app fails to build.
# Generate using: openssl rand -base64 32
# Must be byte-identical to AUTH_SECRET in apps/turboplan and apps/server.
AUTH_SECRET=

# Cookie domain the session cookie is scoped to.
# OPTIONAL.
# If unset: the app's cookie stays host-only, so this page never sees a session
# and always renders the signed-out state. Leave empty for local development —
# localhost:3000 and localhost:3002 cannot share a cookie domain anyway.
# Example: .yourdomain.com (leading dot)
AUTH_COOKIE_DOMAIN=

# =============================================================================
# ANALYTICS
# =============================================================================

# Each provider below is configured by its own variable and is independent of
# the others. In deployments CI fills them from the GitHub environment's
# variables. All are inlined at build time, so a change needs a rebuild. Leave
# them empty locally: local dev sends nothing unless you set them (point them
# at a staging project, never at production).

# PostHog project API key (phc_...) for browser analytics.
# OPTIONAL.
# If unset: PostHog is off — posthog.init is never called and every capture
# no-ops.
# Get it from: PostHog -> Project Settings -> Project API Key.
NEXT_PUBLIC_POSTHOG_KEY=

# PostHog ingestion host.
# OPTIONAL.
# If unset: defaults to "/ingest", the same-origin proxy that survives
# ad-blockers.
NEXT_PUBLIC_POSTHOG_HOST=

# GA4 measurement ID (G-XXXXXXXXXX). Use a different one per environment
# (production vs staging).
# OPTIONAL.
# If unset: GA4 is off — no gtag.js for GA4 and no GA4 events.
# Get it from: GA4 Admin -> Data streams -> the web stream -> Measurement ID.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Ads tag ID (AW-XXXXXXXXXX), loaded by the same gtag.js as GA4. Set it
# in production only, so staging traffic never trains Ads audiences.
# OPTIONAL.
# If unset: the Ads tag is off.
# Get it from: Google Ads -> Goals -> Conversions -> Google tag.
NEXT_PUBLIC_GOOGLE_ADS_TAG_ID=

# =============================================================================
# ERROR MONITORING (Sentry)
# =============================================================================

# Sentry DSN read by the BROWSER bundle. Inlined at build time, so a change
# needs a rebuild.
# OPTIONAL.
# If unset: Sentry.init receives an undefined DSN and no-ops.
# Get it from: Sentry -> Project Settings -> Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN=

# Same DSN for the Node/edge runtime. NEXT_PUBLIC_SENTRY_DSN is used as the
# fallback, so setting only the public one covers both.
# OPTIONAL.
# If unset: server-side Sentry no-ops.
SENTRY_DSN=

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Node environment: development, production or test.
# OPTIONAL — Next.js sets it per command anyway.
# If unset: no failure; it only feeds the Sentry environment tag.
NODE_ENV=development

# Port Next.js listens on.
# OPTIONAL and normally inert — the `dev` script passes `-p 3002`, which wins
# over this variable.
# If you do change the port, update NEXT_PUBLIC_LANDING_URL and the API server's
# ALLOWED_ORIGINS to match.
PORT=3002
